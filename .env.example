# Binance Futures API — Live (mainnet)
BINANCE_API_KEY=your_live_api_key
BINANCE_API_SECRET=your_live_api_secret

# Binance Demo API — Sandbox (demo-fapi.binance.com)
BINANCE_DEMO_API_KEY=your_demo_api_key
BINANCE_DEMO_API_SECRET=your_demo_api_secret

# Market data defaults (symbol/timeframe ใช้เป็น fallback ใน MarketDataService)
SYMBOL=BTC/USDT:USDT
TIMEFRAME=1h

# Notification — no env vars. LINE and Telegram credentials are stored per mode in the
# notification_settings table (secrets encrypted with TOKEN_ENCRYPTION_KEY) and edited in
# the dashboard's Settings page.

# App
# NODE_ENV is required — the app refuses to boot without it. It decides whether TypeORM
# auto-syncs the schema and whether the DB connection uses SSL, so "unset" must never
# quietly mean "not production". Use development | test | production.
NODE_ENV=development
PORT=3001
# Comma-separated allowed CORS origins for the dashboard (unset = allow all, dev only)
# DASHBOARD_ORIGIN=https://your-dashboard.example.com
# Set to "false" only for DB hosts with self-signed certs
# DB_SSL_REJECT_UNAUTHORIZED=false

# Auth Configuration
# Every REPLACE_ME_* value below is rejected at boot — the app will not start until you
# substitute a real one. (The old placeholders were long enough to satisfy the length
# checks, so `cp .env.example .env` produced a bootable app signing JWTs with a secret
# published in this repo.)
# ADMIN_PASSWORD: required at first boot (min 8 chars, must NOT be "admin1234")
# JWT_SECRET: required, min 32 chars — generate with: openssl rand -hex 32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_ME
JWT_SECRET=REPLACE_ME
JWT_EXPIRY=24h

# TOKEN_ENCRYPTION_KEY: required, 64 hex chars (32 bytes) — encrypts the LINE channel
# access token / channel secret and the Telegram bot token stored per-mode in
# notification_settings. Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=REPLACE_ME

# PostgreSQL (docker-compose)
# DB_PASSWORD falls back to the dev default only outside production; in production the
# app refuses to boot without DB_PASSWORD (or DATABASE_URL) rather than trying a
# publicly-guessable credential. Set the same value in docker-compose.
DB_HOST=localhost
DB_USER=shiftbot
DB_PASSWORD=shiftbot
DB_NAME=shiftbot
DB_PORT=5432
