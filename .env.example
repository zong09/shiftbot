# Binance Futures API — Live (mainnet)
BINANCE_API_KEY=your_live_api_key
BINANCE_API_SECRET=your_live_api_secret

# Binance Demo API — Sandbox (demo-fapi.binance.com)
BINANCE_DEMO_API_KEY=your_demo_api_key
BINANCE_DEMO_API_SECRET=your_demo_api_secret

# Market data defaults (symbol/timeframe ใช้เป็น fallback ใน MarketDataService)
SYMBOL=BTC/USDT:USDT
TIMEFRAME=1h

# Notification
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
# LINE Messaging API (LINE Notify was discontinued 2025-03-31)
# ไม่ได้ใช้แล้ว — channel access token / channel secret / group id ย้ายไปเก็บใน
# ตาราง notification_settings แยกตาม mode แก้ผ่านหน้า Settings ของ dashboard
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_TO=your_line_user_id
NOTIFY_CHANNEL=telegram

# App
PORT=3001
# Comma-separated allowed CORS origins for the dashboard (unset = allow all, dev only)
# DASHBOARD_ORIGIN=https://your-dashboard.example.com
# Set to "false" only for DB hosts with self-signed certs
# DB_SSL_REJECT_UNAUTHORIZED=false

# Auth Configuration
# ADMIN_PASSWORD: required at first boot (min 8 chars, must NOT be "admin1234")
# JWT_SECRET: required, min 32 chars — generate with: openssl rand -hex 32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_before_first_boot
JWT_SECRET=generate_with__openssl_rand_hex_32__min_32_chars
JWT_EXPIRY=24h

# TOKEN_ENCRYPTION_KEY: required, 64 hex chars (32 bytes) — encrypts the LINE channel
# access token stored per-mode in notification_settings. Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=generate_with__openssl_rand_hex_32__64_hex_chars

# PostgreSQL (docker-compose)
DB_HOST=localhost
DB_USER=shiftbot
DB_PASSWORD=shiftbot
DB_NAME=shiftbot
DB_PORT=5432
